        "# modify_while_looping.py\n",
        "nums = [1, 2, 2, 3]\n",
        "\n",
        "# Wrong: removing from the list while looping over it\n",
        "for x in nums:\n",
        "    if x == 2:\n",
        "        nums.remove(x)\n",
        "print(\"wrong:\", nums)           # one 2 survived!\n",
        "\n",
        "# Right: build a new list with only what you want to keep\n",
        "nums = [1, 2, 2, 3]\n",
        "kept = []\n",
        "for x in nums:\n",
        "    if x != 2:\n",
        "        kept.append(x)\n",
        "print(\"right:\", kept)"
