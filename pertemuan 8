            "Every 3 h   : [61, 59, 63, 71, 74, 74, 70, 64]\n",
            "Last 6 hours: [70, 68, 66, 64, 63, 62]\n",
            "Reversed    : [62, 63, 64, 66]\n",
            "Lengths     : 6 6 6 6\n"
