      ],
      "source": [
        "# temps_summary.py\n",
        "temps = [\n",
        "    61, 60, 60, 59, 59, 60,   # 00:00–05:00\n",
        "    63, 66, 69, 71, 72, 73,   # 06:00–11:00\n",
        "    74, 74, 75, 74, 73, 72,   # 12:00–17:00\n",
        "    70, 68, 66, 64, 63, 62,   # 18:00–23:00\n",
