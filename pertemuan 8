        "print(\"Range   :\", max(temps) - min(temps), \"°C\")   # highest - lowest\n",
        "\n",
        "hot_hour = temps.index(max(temps))             # POSITION of the highest = the hour\n",
        "print(\"Hottest at\", str(hot_hour) + \":00\")\n",
        "print(\"Midday average:\", round(sum(temps[12:18]) / 6, 1), \"°C\")   # slicing + sum"
      ]
